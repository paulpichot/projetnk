# À copier en .deploy.env (non versionné) : réglages de scripts/deploy.mjs
# Mêmes identifiants que dans FileZilla

FTP_HOST=xxxxxx.ftp.infomaniak.com
FTP_USER=xxxxxx_utilisateur
# Mot de passe : laisser la ligne commentée pour le saisir à chaque déploiement
# FTP_PASSWORD=
# Dossier du site sur le serveur, tel qu'il apparaît dans FileZilla à la connexion (ex. sites/projetnk.org)
REMOTE_DIR=sites/projetnk.org
# false si le serveur refuse la connexion chiffrée
FTP_TLS=true
